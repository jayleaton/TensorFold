 {
  "name": "nested-narrowed",
  "tools": [
   {
    "type": "function",
    "function": {
     "name": "search",
     "parameters": {
      "type": "object",
      "properties": {
       "q": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S"
       },
       "when": {
        "type": "string",
        "format": "date"
       },
       "filters": {
        "type": "object",
        "properties": {
         "lang": {
          "type": "string",
          "enum": [
           "en",
           "fr"
          ]
         },
         "safe": {
          "type": "boolean"
         },
         "n": {
          "type": "number"
         }
        },
        "additionalProperties": true
       },
       "ids": {
        "type": "array",
        "items": {
         "type": "integer"
        }
       },
       "tags": {
        "type": "array"
       },
       "any": {},
       "pick": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "integer"
         }
        ]
       },
       "rows": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/row"
        }
       }
      },
      "required": [
       "q"
      ],
      "$defs": {
       "row": {
        "type": "object",
        "properties": {
         "k": {
          "type": "string"
         },
         "v": {
          "type": "integer"
         }
        },
        "required": [
         "k"
        ]
       }
      }
     }
    }
   }
  ],
  "parallel": false,
  "accept": [
   {
    "name": "search",
    "arguments": {
     "q": "a b",
     "when": "2026-10-24",
     "filters": {
      "lang": "en",
      "safe": true,
      "n": 1.5
     },
     "ids": [
      1,
      2,
      3
     ],
     "tags": [
      "x",
      "y"
     ],
     "any": "free text",
     "pick": 7,
     "rows": [
      {
       "k": "a",
       "v": 1
      },
      {
       "k": "b"
      }
     ]
    }
   },
   {
    "name": "search",
    "arguments": {
     "q": "only"
    }
   }
  ],
  "reject": [
   {
