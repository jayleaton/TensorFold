+test "runner proof: 256-digit division binding refuses narrow and overflowing widths" {
+    const packets = @import("runner_graph_packet.zig");
+    const wide: [256]u8 = @splat('9');
+    const too_wide: [257]u8 = @splat('9');
+    const bound = try packets.Builder.integer(gpa, .divmod, &.{ &wide, "3" });
+    defer gpa.free(bound);
+    try std.testing.expect(std.mem.indexOf(u8, bound, "divmod-256") != null);
+    try std.testing.expectError(error.GraphLiteral, packets.Builder.binaryWidth(gpa, .mod, &wide, "3", 128));
+    try std.testing.expectError(error.GraphLiteral, packets.Builder.integer(gpa, .divmod, &.{ &too_wide, "3" }));
+
+    var both: Both = undefined;
+    try both.open();
+    defer both.close();
+    const a: [256]u8 = @splat('8');
+    var dividend = a;
+    dividend[255] = '7';
+    const b: [129]u8 = @splat('3');
+    var divisor = b;
+    divisor[128] = '1';
+    const neg_a = try std.mem.concat(gpa, u8, &.{ "-", &dividend });
+    defer gpa.free(neg_a);
+    const neg_b = try std.mem.concat(gpa, u8, &.{ "-", &divisor });
+    defer gpa.free(neg_b);
+    const first = try packets.Builder.integer(gpa, .divmod, &.{ neg_a, &divisor });
+    defer gpa.free(first);
+    const second = try packets.Builder.integer(gpa, .divmod, &.{ &dividend, neg_b });
+    defer gpa.free(second);
+    const one = try both.graph.start(1, .{ .kind = .graph, .bytes = first }, 4_000_000);
+    const two = try both.graph.start(2, .{ .kind = .graph, .bytes = second }, 4_000_000);
+    const result_two = finish(both.graph, two);
+    try std.testing.expectEqual(rapi.Status.ok, result_two.status);
+    try std.testing.expectEqualStrings("(-26666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666666667, -48888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888888890)\n", result_two.out);
